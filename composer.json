{
  "name": "masyasmv/aton-statement-parser",
  "description": "Parser and normalizer for ATON broker XML statements. Converts raw XML reports into structured DTOs for convenient data access.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "aton",
    "broker",
    "statement",
    "report",
    "xml",
    "parser",
    "dto",
    "finance"
  ],
  "homepage": "https://github.com/MasyaSmv/aton-statement-parser",
  "support": {
    "issues": "https://github.com/MasyaSmv/aton-statement-parser/issues",
    "source": "https://github.com/MasyaSmv/aton-statement-parser"
  },
  "authors": [
    {
      "name": "MasyaSmv",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.0",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-iconv": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.60",
    "infection/infection": "^0.26",
    "phpstan/phpstan": "^1.11",
    "phpunit/phpcov": "^8.2",
    "phpunit/phpunit": "^9.6",
    "qossmic/deptrac-shim": "^0.24",
    "vimeo/psalm": "^5.26"
  },
  "autoload": {
    "psr-4": {
      "MasyaSmv\\AtonStatementParser\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MasyaSmv\\AtonStatementParser\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover build/logs/clover.xml --coverage-text",
    "coverage:check": "php tools/check-coverage.php build/logs/clover.xml 90",
    "cs:check": "php-cs-fixer fix --diff --dry-run --allow-risky=yes",
    "cs:fix": "php-cs-fixer fix --allow-risky=yes",
    "stan": "phpstan analyse -c phpstan.neon --debug --no-progress",
    "psalm": "psalm --no-cache --threads=1 --output-format=console",
    "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
    "infection": "infection --configuration=infection.json5 --threads=max --only-covered --min-msi=75 --min-covered-msi=85 --no-progress"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "infection/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
